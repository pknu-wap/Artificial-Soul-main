# Local development only. Keep real credentials out of Git.
POSTGRES_DB=artificial_soul
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
QDRANT_PORT=6333

# Keep DATABASE_URL consistent with the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/artificial_soul
QDRANT_URL=http://localhost:6333
HEALTH_CHECK_TIMEOUT_SECONDS=3
QDRANT_REQUEST_TIMEOUT_SECONDS=10
RETRIEVAL_TIMEOUT_SECONDS=30

# Indexing settings. No collection is created during application startup.
QDRANT_COLLECTION_NAME=artificial_soul_e5_small_v1
QDRANT_DISTANCE=Cosine
# This E5 provider uses 384-dimensional normalized dense embeddings.
QDRANT_VECTOR_SIZE=384
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# Relative cache paths resolve from backend, independently of the working directory.
EMBEDDING_CACHE_DIR=.cache/huggingface
EMBEDDING_BATCH_SIZE=32
