# Local development only. Keep real credentials out of Git.
POSTGRES_DB=artificial_soul
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
QDRANT_PORT=6333

# Keep DATABASE_URL consistent with the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/artificial_soul
QDRANT_URL=http://localhost:6333
HEALTH_CHECK_TIMEOUT_SECONDS=3

# Indexing settings. No collection is created during application startup.
QDRANT_COLLECTION_NAME=artificial_soul_knowledge
QDRANT_DISTANCE=Cosine
# Set QDRANT_VECTOR_SIZE to your embedding model's actual dimension when selected.
# Leave it unset for TXT preparation and health checks; do not set an empty value.
# QDRANT_VECTOR_SIZE=<embedding_dimension>
